<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded Button Set | UIVault -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0F1115">

    <Button
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="Primary"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#6C5CE7"
        style="?android:attr/borderlessButtonStyle"
        android:background="@drawable/btn_rounded_20" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="Success"
        android:textColor="#0F1115"
        android:textStyle="bold"
        android:backgroundTint="#00D9C0"
        android:background="@drawable/btn_rounded_20" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="Danger"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#FF6B6B"
        android:background="@drawable/btn_rounded_20" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Outlined"
        android:textColor="#6C5CE7"
        android:textStyle="bold"
        android:background="@drawable/btn_outlined" />

</LinearLayout>

