<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding Screen | UIVault -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="bottom"
    android:padding="24dp"
    android:background="@drawable/bg_gradient_teal_purple">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Track Your Goals"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Stay motivated and reach your targets every single day."
        android:textColor="#F0F0FA"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <View android:layout_width="24dp" android:layout_height="6dp" android:background="#FFFFFF" android:layout_marginEnd="6dp"/>
        <View android:layout_width="8dp" android:layout_height="6dp" android:background="#66FFFFFF" android:layout_marginEnd="6dp"/>
        <View android:layout_width="8dp" android:layout_height="6dp" android:background="#66FFFFFF"/>

    </LinearLayout>

    <Button
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:layout_gravity="end"
        android:text="Next"
        android:textColor="#6C5CE7"
        android:backgroundTint="#FFFFFF"
        android:background="@drawable/btn_rounded_25" />

</LinearLayout>

