<?xml version="1.0" encoding="utf-8"?>
<!-- Chat Bubble UI | UIVault -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1115">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#1A1D24">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_avatar" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView android:text="Sarah Ahmed" android:textColor="#F5F6FA" android:textSize="15sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Online" android:textColor="#00D9C0" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Message bubble - received -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:padding="14dp"
        android:text="Hey! How are you?"
        android:textColor="#FFFFFF"
        android:background="@drawable/bubble_received" />

    <!-- Message bubble - sent -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_gravity="end"
        android:padding="14dp"
        android:text="I'm good, working on the app 🚀"
        android:textColor="#FFFFFF"
        android:background="@drawable/bubble_sent" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:hint="Type a message..."
        android:paddingStart="20dp"
        android:background="@drawable/bg_input_dark" />

</LinearLayout>

<!-- bubble_sent.xml (res/drawable): solid #6C5CE7, corners 18dp -->
<!-- bubble_received.xml (res/drawable): solid #242832, corners 18dp -->
<!-- circle_avatar.xml (res/drawable): oval shape, solid #6C5CE7 -->
